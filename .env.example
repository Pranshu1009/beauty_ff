OWNER_PASSWORD=Roshani@2026

PORT=5000

# Contact form notifications (set these on RENDER)
# Web3Forms access key from https://web3forms.com
WEB3FORMS_ACCESS_KEY=
VITE_WEB3FORMS_ACCESS_KEY=

# WhatsApp auto-alerts via CallMeBot (free, one-time setup)
