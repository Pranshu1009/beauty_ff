# MongoDB Atlas connection string
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/roshani?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-this-to-a-long-random-secret

# Optional: first-time owner account (created only if missing)
OWNER_USERNAME=roshani
OWNER_PASSWORD=Roshani@2026

PORT=5000

# Contact form notifications (set these on RENDER)
# Web3Forms access key from https://web3forms.com
WEB3FORMS_ACCESS_KEY=
VITE_WEB3FORMS_ACCESS_KEY=

# WhatsApp auto-alerts via CallMeBot (free, one-time setup)
# 1) Save this number in your phone contacts: +34 623 76 13 63
# 2) From WhatsApp (9823124595), message that contact:
#    I allow callmebot to send me messages
# 3) Put the API key they reply with here
# Official guide: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=919823124595
CALLMEBOT_API_KEY=
